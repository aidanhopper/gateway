[Unit]
Description=Gateway Reverse Proxy & Stream Routing Daemon
After=network.target network-online.target
Wants=network-online.target
Documentation=https://github.com/aidanhopper/gateway

[Service]
Type=simple
ExecStart=/usr/local/bin/gateway daemon
Restart=always
RestartSec=5s
LimitNOFILE=65536

# Ambient capabilities for binding ports 80/443 and manipulating firewall rules
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
